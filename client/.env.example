# Copy to .env.local (Vite convention) and fill in the real value.
# Same Clerk app as server/.env — use the Publishable Key, not the Secret Key.
VITE_CLERK_PUBLISHABLE_KEY=

# Web Push (G411-29) — same VAPID_PUBLIC_KEY as the root .env. Public key
# only; the private key never leaves the server.
VITE_VAPID_PUBLIC_KEY=
