# Copy to .env and fill in real values. .env is gitignored.

# Postgres connection string (Neon) — used by prisma/schema.prisma
DATABASE_URL=

# Clerk (G411-13) — from https://dashboard.clerk.com > your app > API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

PORT=3000

# Clerk test account (dev-mode sign-in bypass for scripted Playwright
# Falsifier checks) — see gavi411-commit-convention.md's live-auth-check
# section for how these are used. Real values live only in .env.
CLERK_TEST_EMAIL=
CLERK_TEST_PASSWORD=
CLERK_TEST_OTP=

# Cloudinary (G411-26) — from https://cloudinary.com dashboard's API
# Environment variable box (cloud name/key/secret bundled into one URL).
CLOUDINARY_URL=
