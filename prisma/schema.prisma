// Gavi411 — DB schema (G411-10)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum GroupTag {
  CLOSE
  REGULAR
  LIMITED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
}

enum RequestType {
  TRAVEL
  RESEARCH
  PURCHASE
  TECH_SUPPORT
  INFO
  GENERAL
}

enum Status {
  IN_QUEUE
  RECEIVED
  WORKING_ON_IT
  WAITING_ON_USER
  RESOLVED_PENDING_CONFIRMATION
  CLOSED
  CANCELLED
  SELF_SOLVED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REJECTED
}

// Invite tokens (G411-41). Admin creates one (no email needed up front —
// Gavi may not know it, or the friend signs up via Google OAuth with a
// different address than expected). The token itself is the gate: the
// app checks `?token=` before letting a visitor reach Clerk's sign-in at
// all. `usedAt`/`usedByUserId` are set together, once, on first
// successful sign-in (see requireAuth in server/middleware/auth.js) —
// one-time by construction, not by a separate "used" boolean that could
// drift from usedByUserId.
model PendingInvite {
  token        String    @id
  label        String? // Gavi's own reference note, not shown to the invitee
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  usedByUserId String?   @unique
  usedByUser   User?     @relation(fields: [usedByUserId], references: [clerkId])

  // Escrow (G411-28 stage 4). The passphrase itself is generated at
  // invite-creation time (server/routes/invites.js) and returned ONCE in
  // that response — never stored here or anywhere else in plaintext. What
  // IS stored is the encrypted backup of the friend's escrow private key,
  // uploaded by their browser at signup once it's wrapped client-side
  // (client/src/lib/crypto.js's escrowPrivateKey) — the server never sees
  // an unwrapped key or the passphrase that would unwrap it. All three
  // fields are set together, once, by the same request, or not at all.
  backupSalt       String?
  backupIv         String?
  backupCiphertext String?
}

model User {
  clerkId       String   @id
  role          Role     @default(USER)
  firstName     String
  lastName      String
  email         String?  @unique
  // G411-80: Clerk's own username field — nullable, existing users have
  // none until they set one; Clerk enforces its own uniqueness too, but
  // this @unique guards our side independently (same reasoning as email).
  username      String?  @unique
  phoneNumber   String   @unique
  profilePic    String?
  groupTag      GroupTag @default(REGULAR)
  creditBalance Int
  // G411-46: timestamp of the most recent credit reset for this user.
  // Null means never reset (existing users); set to signup time for new
  // users so they don't get re-reset immediately.
  creditsResetAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  isBlocked     Boolean  @default(false)

  // E2E messaging (G411-82). Raw ECDH public key, base64 (see
  // client/src/lib/crypto.js's exportPublicKey) — uploaded once at
  // signup, right after the device generates its (non-extractable)
  // keypair. Null means this user has no keypair yet (a test/dev account
  // created directly, never through a real invite-signup, or the admin
  // before the one-off bootstrap below) — /api/requests/:id/messages
  // refuses to accept a message from a sender with no public key rather
  // than silently falling back to plaintext.
  publicKey String?

  request            Request[]
  messages           Message[]
  creditTransactions CreditTransaction[]
  usedInvite         PendingInvite?
  devices            Device[]
  pushSubscriptions  PushSubscription[]
}

// Web Push delivery target (G411-29). Deliberately separate from Device
// (E2E crypto identity, G411-28) — a push subscription's lifecycle doesn't
// track a device's crypto trust status at all: clearing site data kills a
// subscription without touching E2E approval, and a subscription can be
// (re)created any time independent of keypair generation. One row per
// browser/PWA install that has granted push permission; a user can have
// several (phone + desktop). `endpoint` is unique per browser install —
// re-subscribing the same browser upserts rather than duplicating.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [clerkId])
  endpoint  String   @unique
  p256dh    String // browser-issued public key, base64url
  auth      String // browser-issued auth secret, base64url
  createdAt DateTime @default(now())
}

// Multi-device support (G411-28's device-linking, 2026-09-01). `User.
// publicKey` above stays as the account's original/primary device (the one
// created at signup) for backward compat with G411-82's existing send/
// receive path — every additional device a user signs in from is a row
// here instead. A PENDING row means "signed in via Clerk, generated its
// own local keypair, waiting on admin to grant it access to existing
// conversations" (see ConversationDeviceKey below for what "access"
// concretely means — this table alone doesn't grant anything).
model Device {
  id         Int          @id @default(autoincrement())
  userId     String
  user       User         @relation(fields: [userId], references: [clerkId])
  publicKey  String
  status     DeviceStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  approvedAt DateTime?

  conversationKeys ConversationDeviceKey[]
}

// One row per (conversation, linked device) — the conversation's AES-GCM
// key, wrapped (AES-KW) for this specific device's public key so only that
// device's own private key can unwrap it. Written once, in a batch, right
// when admin approves a device (every Request admin is a party to gets
// wrapped at once — Gavi's call, "new device inherits everything
// immediately" over lazy per-conversation wrapping). The device fetches
// its own rows, unwraps each with ECDH(device.privateKey, admin.publicKey),
// and from then on decrypts that conversation's messages exactly like any
// other device would — no per-message re-encryption, no change to how
// Message.content is stored or read.
model ConversationDeviceKey {
  id         Int      @id @default(autoincrement())
  requestId  Int
  request    Request  @relation(fields: [requestId], references: [id])
  deviceId   Int
  device     Device   @relation(fields: [deviceId], references: [id])
  wrappedKey String // base64 AES-KW-wrapped conversation key
  iv         String // base64, AES-KW wrap IV
  createdAt  DateTime @default(now())

  @@unique([requestId, deviceId])
}

model Request {
  id             Int          @id @default(autoincrement())
  status         Status       @default(IN_QUEUE)
  urgency        Urgency      @default(NORMAL)
  type           RequestType?
  freeText       String
  additionalInfo String?
  // Type-specific follow-up fields (TravelFields/PurchaseFields/
  // TechSupportFields — G411-65), shape varies per type. Empty/blank
  // fields are stripped before save (G411-23) so this never holds
  // untouched keys. Rendered with per-type labels in the admin detail
  // screen (G411-38, not yet built). Postgres JSONB reorders keys
  // alphabetically on storage — content is unaffected, don't rely on
  // key order when reading this back.
  typeDetails    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // G411-90: set (to the moment refundCredit fires) when this request
  // exits into a refunded status (CANCELLED/SELF_SOLVED, no admin had
  // messaged); cleared back to null when a reopen re-charges that credit.
  // Answers "does reopening THIS request right now owe a credit back?"
  // without needing to re-derive history or link CreditTransaction rows
  // to a request. Confirmed with Gavi: a request that exited WITHOUT a
  // refund (e.g. admin already messaged, hasAdminMessaged blocked the
  // refund) must reopen for free — it was already paid for once and
  // never refunded, so charging again would be a real double-charge.
  refundedAt     DateTime?
  // G411-93: timestamp of the most recent manual nudge #1 on this request.
  // Null means never nudged, or nudge sequence was reset by a friend reply.
  // Used to gate the manual nudge endpoint (can only nudge once per cycle)
  // and to drive the auto-escalation timeline (nudge #2 at +7 days,
  // auto-close at +14 days).
  nudgedAt       DateTime?
  // G411-93: timestamp when nudge #2 was sent. Null means nudge #2 not sent
  // yet in this cycle, or nudge sequence was reset by a friend reply.
  // Replaces fragile text-matching detection (checking message.content).
  nudgeTwoSentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [clerkId])

  message                Message[]
  note                   Note[]
  conversationDeviceKeys ConversationDeviceKey[]
}

model Message {
  id        Int      @id @default(autoincrement())
  // Plaintext for pre-G411-82 rows (`encrypted: false`). For a new
  // encrypted row, this holds JSON.stringify({ iv, ciphertext }) (both
  // base64 — see client/src/lib/crypto.js's encrypt()) — no shape change
  // to the column itself, just what gets stored in it (Gavi's call,
  // ponytail: avoids a second content-shaped column). `encrypted` is the
  // real, explicit signal for which one a row is — not content-sniffing.
  content   String
  encrypted Boolean  @default(false)
  imageUrl  String?
  // G411-93: system messages (nudges #1, #2) authored by admin but not
  // real chat messages. Used to exclude these from refund eligibility checks
  // (hasAdminMessaged) without matching exact text. Even though these are
  // authored as admin, they're not "admin replied" for refund/access purposes.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  requestId Int
  request   Request @relation(fields: [requestId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [clerkId])
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  requestId Int
  request   Request @relation(fields: [requestId], references: [id])
}

model CreditTransaction {
  id        Int      @id @default(autoincrement())
  amount    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [clerkId])
}

model Trigger {
  id          Int         @id @default(autoincrement())
  keyword     String
  requestType RequestType

  // Added 2026-08-24 (real gap found in a live-state review) — seed.js had
  // no idempotency guard and could double-insert rows on a rerun.
  @@unique([keyword, requestType])
}

// Presence (G411-43) — single global row, id fixed to "singleton" so
// there's exactly one and it's trivial to upsert without a race. There's
// one Gavi, not one row per admin — no reason to model this per-user.
// Offline still accepts requests (PRD §4.5); this flag only changes what
// friends are shown, never gates any route.
model Presence {
  id       String  @id @default("singleton")
  isOnline Boolean @default(true)
}
